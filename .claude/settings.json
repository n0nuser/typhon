{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-gates.sh",
            "if": "Bash(git push*)",
            "timeout": 300,
            "statusMessage": "Running gofmt/vet/lint/test gates before push..."
          }
        ]
      }
    ]
  }
}
